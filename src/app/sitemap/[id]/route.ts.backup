import { NextRequest, NextResponse } from 'next/server';
import { prisma } from '@/lib/db/prisma';
import { blogPosts } from '@/data/blog-posts';
import { blogCategories } from '@/data/blog-categories';
import { blogAuthors } from '@/data/blog-authors';
import { blogTags } from '@/data/blog-posts';

/**
 * =============================================================================
 * INDIVIDUAL SITEMAPS - Google Search Console Compliant
 * =============================================================================
 *
 * This route handler generates individual sitemaps (0.xml, 1.xml, 2.xml, 3.xml)
 * with proper XML formatting and headers for Google Search Console.
 *
 * SITEMAP BREAKDOWN:
 * - /sitemap/0.xml: Main pages (static, services, blog) ~200 URLs
 * - /sitemap/1.xml: Service locations (from database) ~8,000 URLs
 * - /sitemap/2.xml: Fleet pages (from database) ~4,000 URLs
 * - /sitemap/3.xml: City homepages + blog tags (from database) ~400 URLs
 *
 * REQUIREMENTS MET:
 * ✓ Proper XML declaration
 * ✓ Correct urlset namespace
 * ✓ Content-Type: application/xml
 * ✓ No future dates (always current or past)
 * ✓ Force-dynamic to prevent caching
 * ✓ Database-driven (real data only)
 * ✓ Google Search Console compatible
 *
 * =============================================================================
 */

// Force dynamic rendering - no caching, always fresh for Google
export const dynamic = 'force-dynamic';
export const revalidate = 0;

const BASE_URL = 'https://transrentals.in';

