  updatedAt                                       DateTime                    @updatedAt
  lastPaymentError                                String?                     @db.Text
  notifiedVendorIds                               String?                     @db.LongText
  paymentAttempts                                 Int                         @default(0)
  razorpayOrderId                                 String?
  razorpayPaymentId                               String?
  razorpaySignature                               String?
  requestedModelId                                String?
  version                                         Int                         @default(0)
  actualReturnDate                                DateTime?
  advanceAmount                                   Float?
  advancePaymentDate                              DateTime?
  advancePaymentProof                             String?
  advancePaymentRef                               String?
  advancePaymentVerified                          Boolean                     @default(false)
  advanceVerifiedAt                               DateTime?
  advanceVerifiedBy                               String?
  damageCharges                                   Float?
  finalPaymentAmount                              Float?
  finalPaymentAt                                  DateTime?
  finalPaymentMethod                              String?
  finalPaymentRef                                 String?
