  vendors_bike_bookings_assignedVendorIdTovendors vendors?                    @relation("bike_bookings_assignedVendorIdTovendors", fields: [assignedVendorId], references: [id])
  customers                                       customers?                  @relation(fields: [customerId], references: [id])
  locations                                       locations                   @relation(fields: [locationId], references: [id])
