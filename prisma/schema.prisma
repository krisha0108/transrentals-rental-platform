  @@index([vendorId])
  @@index([vendorFleetId])
  @@index([incidentDate])
  @@index([status])
}

model fleet_fuel_records {
  id              String        @id
  vendorId        String
  vendorFleetId   String
  fuelDate        DateTime      @db.Date
  fuelType        String?
  quantity        Float
  pricePerUnit    Float
  totalCost       Float
  odometerReading Int?
  fuelStation     String?
  paymentMode     String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vendor_fleets   vendor_fleets @relation(fields: [vendorFleetId], references: [id], onDelete: Cascade)
  vendors         vendors       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vendorFleetId])
  @@index([fuelDate])
}

