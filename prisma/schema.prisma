  @@index([assignedVendorId])
  @@index([bookingNumber])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([customerId])
  @@index([customerPhone])
  @@index([locationId])
  @@index([pickupDate])
  @@index([requestedModelId])
