generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model active_sessions {
  id               String   @id
  sessionId        String   @unique
  currentPage      String
  pageTitle        String?
  startTime        DateTime @default(now())
  lastActivity     DateTime @default(now())
  pageCount        Int      @default(1)
  device           String?
  browser          String?
  os               String?
  country          String?
  city             String?
  referrer         String?
  utmSource        String?
  utmMedium        String?
  hasInteracted    Boolean  @default(false)
  hasChatted       Boolean  @default(false)
  hasSubmittedForm Boolean  @default(false)

  @@index([lastActivity])
  @@index([sessionId])
}

model admin_users {
  id                       String                     @id
  email                    String                     @unique
  password                 String
  name                     String
  role                     admin_users_role           @default(ADMIN)
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  createdById              String?
  phone                    String?
  admin_users              admin_users?               @relation("admin_usersToadmin_users", fields: [createdById], references: [id])
  other_admin_users        admin_users[]              @relation("admin_usersToadmin_users")
  blog_posts               blog_posts[]
  manager_locations        manager_locations[]
  manager_services         manager_services[]
  pages                    pages[]
  vendor_documents         vendor_documents[]
  vendor_location_requests vendor_location_requests[]
  vendor_payout_batches    vendor_payout_batches[]
  vendor_service_requests  vendor_service_requests[]
  vendors                  vendors[]

  @@index([createdById], map: "admin_users_createdById_fkey")
}

model analytics_summary {
  id                   String   @id
  date                 DateTime @unique @db.Date
  totalPageViews       Int      @default(0)
  uniqueVisitors       Int      @default(0)
  newVisitors          Int      @default(0)
  returningVisitors    Int      @default(0)
  avgSessionDuration   Int      @default(0)
  avgPagesPerSession   Float    @default(0)
  bounceRate           Float    @default(0)
  totalFormViews       Int      @default(0)
  totalFormStarts      Int      @default(0)
  totalFormSubmissions Int      @default(0)
  formConversionRate   Float    @default(0)
  totalChatSessions    Int      @default(0)
  totalChatMessages    Int      @default(0)
  chatBookings         Int      @default(0)
  chatConversionRate   Float    @default(0)
  totalClicks          Int      @default(0)
  ctaClicks            Int      @default(0)
  phoneClicks          Int      @default(0)
  avgLcp               Float?
  avgFid               Float?
  avgCls               Float?
  pagesWithIssues      Int      @default(0)
  topPages             String?  @db.LongText
  topReferrers         String?  @db.LongText
  topFormPages         String?  @db.LongText
  topChatPages         String?  @db.LongText
  mobileVisitors       Int      @default(0)
  desktopVisitors      Int      @default(0)
  tabletVisitors       Int      @default(0)
  directTraffic        Int      @default(0)
  organicTraffic       Int      @default(0)
  referralTraffic      Int      @default(0)
  socialTraffic        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([date])
}

model backlinks {
  id              String    @id
  sourceUrl       String
  sourceDomain    String
  targetUrl       String
  anchorText      String?
  isDoFollow      Boolean   @default(true)
  isNoFollow      Boolean   @default(false)
  domainAuthority Int?
  pageAuthority   Int?
  spamScore       Int?
  isActive        Boolean   @default(true)
  lastChecked     DateTime?
  firstSeen       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([sourceUrl, targetUrl])
  @@index([domainAuthority])
  @@index([sourceDomain])
  @@index([targetUrl])
}

model bank_details {
  id                String    @id
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String
  branchName        String?
  accountType       String    @default("SAVINGS")
  upiId             String?
  upiQrCode         String?
  isActive          Boolean   @default(true)
  isPrimary         Boolean   @default(false)
  displayOrder      Int       @default(0)
  serviceId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  services          services? @relation(fields: [serviceId], references: [id])

  @@index([isActive])
  @@index([isPrimary])
  @@index([serviceId])
}

