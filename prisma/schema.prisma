  blog_categories blog_categories?  @relation(fields: [categoryId], references: [id])
  seo_meta        seo_meta?

  @@index([authorId], map: "blog_posts_authorId_fkey")
  @@index([categoryId], map: "blog_posts_categoryId_fkey")
  @@index([publishedAt])
  @@index([slug])
  @@index([status])
  @@index([serviceSlug])
}

