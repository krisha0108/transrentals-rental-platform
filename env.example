# App Configuration
NEXT_PUBLIC_APP_NAME=TransRentals
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=India's Largest Vehicle Rental Marketplace

# ===========================================
# BACKEND API CONFIGURATION
# ===========================================
# TransRentals CRM Backend API URL
# This connects to the Laravel backend (transrentals_crm_HOC)
NEXT_PUBLIC_API_URL=https://app.transrentals.in/api
NEXT_PUBLIC_API_TIMEOUT=15000

# ===========================================
# AUTHENTICATION
# ===========================================
# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Google OAuth (for customer Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# DATABASE (Optional - for local caching)
# ===========================================
# Prisma Database URL (Required for build)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/transrentals

# ===========================================
# GOOGLE ANALYTICS
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ===========================================
# CONTACT INFORMATION
# ===========================================
NEXT_PUBLIC_CONTACT_EMAIL=support@transrentals.in
NEXT_PUBLIC_CONTACT_PHONE=+91-XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=+91-XXXXXXXXXX

# ===========================================
# SOCIAL MEDIA
# ===========================================
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/transrentals
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/transrentals
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/transrentals
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/transrentals

# ===========================================
# FEATURE FLAGS
# ===========================================
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_VENDOR_SIGNUP=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ===========================================
# SEO
# ===========================================
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/images/og-image.jpg
NEXT_PUBLIC_TWITTER_HANDLE=@transrentals

# ===========================================
# BLOG DATA SOURCE
# ===========================================
# Options: mock, prisma, laravel
NEXT_PUBLIC_BLOG_DATA_SOURCE=mock

# ===========================================
# BACKR REWARDS (backrcoin.org) — server-side only
# ===========================================
# APP_URL: public domain for BACKR redirectUri — never use req.headers.host (Docker leaks container hostname)
APP_URL=https://transrentals.in
BACKR_API_KEY=
BACKR_BASE_URL=https://backrcoin.org

# ===========================================
# ANTHROPIC (CLAUDE AI) - Document OCR
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ===========================================
# WHATSAPP BUSINESS CLOUD API (Meta)
# ===========================================
# Direct integration with Meta Cloud API — no BSP.
# Without these set, all WhatsApp sends are no-op (logged as debug).
# See src/lib/whatsapp/README.md for Meta setup steps + template text.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional, for reference only — not read by client.ts:
WHATSAPP_BUSINESS_ACCOUNT_ID=
