# ===========================================
# Docker Environment Configuration
# Copy this file to .env and update values
# ===========================================

# ============================================
# MySQL Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=transrentals
MYSQL_USER=transrentals_user
MYSQL_PASSWORD=your_strong_user_password_here
MYSQL_PORT=3306

# ============================================
# Application Configuration
# ============================================
APP_PORT=3000

# Database URL (should match MySQL config above)
DATABASE_URL=mysql://transrentals_user:your_strong_user_password_here@mysql:3306/transrentals

# ============================================
# NextAuth Configuration
# ============================================
NEXTAUTH_URL=http://localhost:3000
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-32-character-string-minimum

# ============================================
# Optional: Seed Database
# ============================================
SEED_DATABASE=false

# ============================================
# Public Environment Variables (for build)
# ============================================
NEXT_PUBLIC_APP_NAME=TransRentals
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=info@transrentals.com
NEXT_PUBLIC_CONTACT_PHONE=+91-XXXXXXXXXX
