{
  "name": "transrentals-web",
  "version": "1.0.0",
  "description": "TransRentals - India's Largest Vehicle Rental Marketplace",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:socket": "tsx server.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "start:socket": "node dist/server.js",
    "security:audit": "bash scripts/security-audit.sh",
    "preinstall": "echo '🔒 Running security checks before install...'",
    "postinstall": "node -e \"try{require('fs').rmSync('node_modules/.prisma',{recursive:true,force:true})}catch(e){}\" && (prisma generate || echo 'Prisma generate skipped - will be run in build step') && (npm audit --audit-level=high || true)",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:sitemap": "ts-node scripts/generate-sitemap.ts",
    "generate:redirects": "node scripts/generate-redirects.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "npx prisma generate",
    "db:deploy": "npx prisma migrate deploy",
    "db:status": "npx prisma migrate status",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:update": "npx prisma generate && npx prisma migrate deploy",
    "post-pull": "npm install && npm run db:update",
    "deploy": "npm install && npx prisma migrate deploy && npx prisma generate && npm run build",
    "deploy:check": "npx prisma migrate status && npm run type-check",
    "audit": "node scripts/audit.js",
    "audit:verbose": "node scripts/audit.js --verbose",
    "audit:json": "node scripts/audit.js --json"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.4",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.59.20",
    "@tiptap/pm": "^3.10.8",
    "@tiptap/react": "^3.10.8",
    "@tiptap/starter-kit": "^3.10.8",
    "@types/jsonwebtoken": "9.0.10",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.5.1",
    "framer-motion": "^11.18.2",
    "html2canvas": "1.4.1",
    "jsonwebtoken": "9.0.3",
    "jspdf": "4.0.0",
    "lucide-react": "^0.454.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.3",
    "nodemailer": "^7.0.12",
    "prisma": "6.19.2",
    "rate-limiter-flexible": "9.1.0",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-day-picker": "^9.4.3",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.53.2",
    "recharts": "^3.5.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "vaul": "^1.1.1",
    "xlsx": "0.18.5",
    "xss": "1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "cross-env": "10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "mysql2": "3.16.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
